# Local development only. Copy to .env and replace this JWT placeholder before sharing a setup.
APP_ENV=development

# Host commands use localhost; Compose injects the service-network addresses separately.
# Host commands do not expand ${VAR}; use literal values in .env.
DATABASE_URL=postgresql+asyncpg://grader:grader@localhost:5432/grader
COMPOSE_DATABASE_URL=postgresql+asyncpg://grader:grader@postgres:5432/grader
TEST_DATABASE_URL=postgresql+asyncpg://grader:grader@localhost:5433/grader_test
# Do not persist MIGRATION_LEGACY_PROCESSES_STOPPED=true here. Set it only on a
# migration command after every legacy API/worker/beat/shell DB session is stopped.
REDIS_URL=redis://localhost:6379/0
COMPOSE_REDIS_URL=redis://redis:6379/0

# Safe only for development/test. Replace with a random secret for any shared environment.
JWT_SECRET=development-secret-change-me
JWT_EXP_MINUTES=60
AGENT_PROVIDER=mock
# Deterministic demo scenario; never inferred from student answer text.
AGENT_MOCK_FIXTURE=partial
# Used only when AGENT_PROVIDER=openai-compatible.
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=grader-v1
AGENT_RESPONSE_FORMAT=json-schema
# AGENT_API_KEY=replace-with-provider-key
AGENT_ALLOW_INSECURE_HTTP=false
AGENT_TIMEOUT_SECONDS=30
EVALUATION_DISPATCH_ENABLED=true
CELERY_TASK_ALWAYS_EAGER=false
CORS_ORIGINS='["http://localhost:5173"]'

# Mattermost Compose profile. This public fallback is local-only; replace it before
# exposing or sharing the runtime. The same raw value is used by PostgreSQL and in a
# connection URL, so it must be at least 16 characters from [A-Za-z0-9._~-]. Values
# outside that set are rejected before Mattermost starts; do not percent-encode one
# use while leaving the other raw. Never commit real provider, bot, or signing keys.
MATTERMOST_DB_PASSWORD=mm-local-9Jv7wQ2xR5cN8kT4
MATTERMOST_SITEURL=http://localhost:8065

# Mattermost A7 Slash Command adapter. Uncomment and replace for local integration.
# MATTERMOST_COMMAND_TOKEN=replace-with-slash-command-token
# MATTERMOST_DEMO_SETUP_KEY=replace-with-random-demo-key
# DEMO_SETUP_KEY=replace-with-random-demo-bootstrap-key

# Mattermost A8 Bot delivery and signed interactive actions. Replace every enabled value.
# MATTERMOST_URL=http://mattermost:8065
# MATTERMOST_BOT_TOKEN=replace-with-bot-token
# MATTERMOST_BOT_USER_ID=replace-with-bot-user-id
# MATTERMOST_ACTION_SECRET=replace-with-random-action-secret
# MATTERMOST_ACTION_URL=http://api:8000/api/v1/integrations/mattermost/actions
# WEB_CONSOLE_URL=http://localhost:8080

# Non-sensitive local database defaults used by Compose.
POSTGRES_DB=grader
POSTGRES_TEST_DB=grader_test
POSTGRES_USER=grader
POSTGRES_PASSWORD=grader
# If POSTGRES_PORT or TEST_POSTGRES_PORT changes, update the matching host URL above.
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=5433
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=8080
MATTERMOST_PORT=8065
